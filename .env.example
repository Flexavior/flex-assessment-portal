# Active provider: ollama | openai | openrouter | gemini | omnirouter | groq
LLM_PROVIDER=openrouter

# Embeddings (local Ollama — one-time Chroma index of slides)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
TEMPERATURE=0.1
REQUEST_TIMEOUT=600
# Local Ollama only (6GB VRAM). Cloud/gateway providers always use REQUEST_TIMEOUT.
LOCAL_REQUEST_TIMEOUT=1800
INDEX_INCLUDE_TEXTBOOK=true
CHUNK_SIZE=800
CHUNK_OVERLAP=80
SLIDES_TOP_K=3
TEXTBOOK_TOP_K=2

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI (direct) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini (direct, OpenAI-compatible endpoint) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OmniRoute local gateway (routes to many providers) ---
# LLM_PROVIDER=omnirouter
# OMNIROUTER_API_KEY=sk-your-omniroute-key
# OMNIROUTER_MODEL=auto
# OMNIROUTER_BASE_URL=http://localhost:20128/v1

# --- Groq ---
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Local Ollama ---
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3.5:9b
